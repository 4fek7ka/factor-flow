{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "node",

    "types": ["jest", "node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,

    "strict": true,
    "noEmit": true
  },
  "include": ["tests"]
}
